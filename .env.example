# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
REDIS_URL=redis://localhost:6379

JWT_SECRET=your_jwt_secret_here
RESET_SECRET=your_reset_secret_here

MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password

CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: path to Firebase service account JSON (FCM). Leave unset to disable FCM locally.
# Can be the same file as GOOGLE_APPLICATION_CREDENTIALS if one GCP service account is used for both.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Google Cloud Vision (OCR) — service account JSON path (NOT the Gemini / AI Studio API key).
# ⚠️ Enable "Cloud Vision API" in Google Cloud Console for this project.
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json

PORT=3005

# Google AI Studio — CarLo chatbot (Gemini + RAG). Separate from Cloud Vision.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: model id (default gemini-2.0-flash). Try gemini-1.5-flash-latest if supported by your key.
# GEMINI_MODEL=gemini-2.0-flash
